# --- Copie ce fichier en ".env" et remplis avec tes vraies valeurs ---
# NE JAMAIS committer le fichier ".env" réel dans un dépôt git.

# Port du serveur
PORT=3000

# Secret utilisé pour signer les cookies de session (chaîne aléatoire longue)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Stockage persistant ---
# Deux options, choisies automatiquement (DATABASE_URL prioritaire) :
#
# Option A - Base de données (recommandé pour un vrai déploiement) :
# Ajoute un plugin PostgreSQL sur Railway, puis référence son URL ici.
# La table kv_store est créée automatiquement au démarrage.
DATABASE_URL=
# Vérification du certificat TLS du serveur Postgres quand l'URL contient
# sslmode=require. Par défaut "true" (le certificat est vérifié, ce qui protège
# la connexion contre une attaque de type man-in-the-middle). Ne mettre "false"
# QUE si ton fournisseur présente un certificat auto-signé dont tu acceptes le
# risque en connaissance de cause.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Option B - Fichiers JSON sur un volume (plus simple, moins robuste) :
# Utilisé seulement si DATABASE_URL est vide. Attache un volume Railway et
# mets ici son point de montage (ex: /data) pour que les comptes et le journal
# d'audit survivent aux redéploiements.
DATA_DIR=

# --- Sauvegardes automatiques des données ---
# Snapshots rotatifs de data/ (users, roles, audit, config) dans DATA_DIR/backups.
BACKUP_KEEP=14            # nombre de snapshots conservés
BACKUP_INTERVAL_HOURS=6  # fréquence des snapshots


# --- Compte administrateur initial ("seed admin") ---
# Au démarrage, ce compte est créé dans data/users.json avec le rôle "admin"
# s'il n'existe pas déjà. Il sert de premier administrateur : les autres
# utilisateurs s'inscrivent ensuite via /signup.html (rôle "viewer" par défaut)
# et l'admin leur affecte un rôle depuis la page Admin.
# Génère le hash avec : node -e "console.log(require('bcryptjs').hashSync('ton_mot_de_passe', 10))"
APP_USER_EMAIL=you@bigsolutions.io
APP_USER_PASSWORD_HASH=REMPLACE_PAR_UN_HASH_BCRYPT

# --- Inscription & vérification d'email ---
# Vérification d'email des nouveaux comptes (recommandé). Mettre "false" pour
# connecter directement les inscrits (démo locale sans email).
REQUIRE_EMAIL_VERIFICATION=true
# Restreint l'inscription à certains domaines (séparés par des virgules).
# Vide = tous les domaines autorisés. Ex: bigsolutions.io,contractor.com
SIGNUP_ALLOWED_DOMAINS=
# Envoi des emails de vérification. Sans SMTP, le lien de vérification est
# seulement écrit dans les logs du serveur (utile en local). Pour un envoi réel,
# renseigne SMTP_HOST + SMTP_PORT (+ éventuellement SMTP_USER/SMTP_PASS) et
# installe nodemailer (npm i nodemailer).
# --- Envoi d'emails via l'API HTTP de Resend (recommandé) ---
# Fonctionne même quand l'hébergeur bloque les ports SMTP sortants (25/465/587),
# ce qui est le cas sur les plans gratuits/Hobby de Railway. Si RESEND_API_KEY
# est défini, il est utilisé en priorité sur les variables SMTP_* ci-dessous.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Security Console <no-reply@bigsolutions.io>

# --- Connexion Google ("Sign in with Google") ---
# Client ID créé sur console.cloud.google.com (APIs & Services > Credentials).
# Laisser vide désactive simplement le bouton Google (pas d'erreur).
GOOGLE_CLIENT_ID=
# Emails Google supplémentaires autorisés à se connecter (en plus de APP_USER_EMAIL), séparés par des virgules.
GOOGLE_ALLOWED_EMAILS=

# --- DefectDojo ---
# URL de base de ton instance DefectDojo (sans slash final), ex: https://defectdojo.bigsolutions.io
DEFECTDOJO_BASE_URL=
# Token API DefectDojo (Settings > API v2 Key dans DefectDojo)
DEFECTDOJO_API_TOKEN=

# --- Jira ---
# URL de ton instance Jira Cloud, ex: https://bigsolutions.atlassian.net
JIRA_BASE_URL=
# Email du compte utilisé pour l'API token Jira
JIRA_EMAIL=
# API token Jira (id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=
